# Copia este archivo como .env cuando quieras probar contra Supabase/Postgres.
# No subas un .env real con contrasenas al repositorio.

NODE_ENV=production
API_HOST=0.0.0.0
# En Render/Railway normalmente PORT lo define la plataforma. API_PORT tiene prioridad si existe.
API_PORT=3001

AUTH_SECRET=cambia-esta-clave-por-una-muy-larga-y-privada
TOKEN_TTL_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_WINDOW_MINUTES=15
LOGIN_IP_MAX_ATTEMPTS=40
PASSWORD_RESET_WINDOW_MINUTES=30
PASSWORD_RESET_MAX_REQUESTS=5
SHOW_RECOVERY_CODE_IN_RESPONSE=false
EMAIL_PROVIDER=resend
EMAIL_FROM=LIGA TEC <no-reply@ligatec.mx>
RESEND_API_KEY=resend_api_key
APP_BASE_URL=https://ligatec.mx
SEED_DEMO_USERS=false
TRUST_PROXY=true
JSON_BODY_LIMIT=2mb
SERVE_STATIC=true
PUBLIC_CACHE_SECONDS=5
IMAGE_UPLOAD_MAX_BYTES=1800000

IMAGE_STORAGE_PROVIDER=supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-solo-en-api
SUPABASE_STORAGE_BUCKET=ligatec-images
# Opcional si usas CDN o dominio propio para assets.
STORAGE_PUBLIC_BASE_URL=

DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Supabase normalmente requiere SSL. Solo pon false en entornos locales controlados.
DATABASE_SSL=true

# Dominio publico final.
CORS_ORIGIN=https://tu-dominio.com

# Frontend. Si la API y la web viven en el mismo dominio, usa /api.
VITE_API_BASE_URL=/api
