# Copia este archivo como .env cuando quieras probar contra Supabase/Postgres.
# No subas un .env real con contrasenas al repositorio.

NODE_ENV=production
API_HOST=0.0.0.0
# En Render/Railway normalmente PORT lo define la plataforma. API_PORT tiene prioridad si existe.
API_PORT=3001

AUTH_SECRET=cambia-esta-clave-por-una-muy-larga-y-privada
TOKEN_TTL_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
SHOW_RECOVERY_CODE_IN_RESPONSE=false

DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Supabase normalmente requiere SSL. Solo pon false en entornos locales controlados.
DATABASE_SSL=true

# Dominio desde donde se consumira la API.
CORS_ORIGIN=https://tu-dominio-o-vercel.app

# Frontend. Si web y API quedan en dominios separados, usa la URL publica de la API.
VITE_API_BASE_URL=https://tu-api.com/api
