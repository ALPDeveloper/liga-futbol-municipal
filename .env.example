# Copia este archivo como .env para desarrollo local o configuralo en el servidor.

NODE_ENV=development
API_HOST=127.0.0.1
# En algunos hosts se inyecta PORT automaticamente. API_PORT tiene prioridad si existe.
API_PORT=3001

# En produccion debe ser una cadena larga y privada. No usar este ejemplo.
AUTH_SECRET=cambia-esta-clave-por-una-muy-larga-y-privada
TOKEN_TTL_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_WINDOW_MINUTES=15
LOGIN_IP_MAX_ATTEMPTS=40
PASSWORD_RESET_WINDOW_MINUTES=30
PASSWORD_RESET_MAX_REQUESTS=5
TRUST_PROXY=false
JSON_BODY_LIMIT=2mb
PUBLIC_CACHE_SECONDS=5
IMAGE_UPLOAD_MAX_BYTES=1800000

# Desarrollo local guarda imagenes en /uploads.
# En produccion usar IMAGE_STORAGE_PROVIDER=supabase.
IMAGE_STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=ligatec-images
# STORAGE_PUBLIC_BASE_URL=

# En desarrollo puede estar en true para probar recuperacion.
# En produccion debe ser false y conectar correo/WhatsApp.
SHOW_RECOVERY_CODE_IN_RESPONSE=false
# Opcional para recuperacion real por correo. Requiere proveedor Resend.
# EMAIL_PROVIDER=resend
# EMAIL_FROM=LIGA TEC <no-reply@tudominio.com>
# RESEND_API_KEY=
# APP_BASE_URL=https://ligatec.mx

# Solo true en desarrollo local. En produccion debe ser false.
SEED_DEMO_USERS=true

# Opcional. Si no se define, usa data/liga-futbol.sqlite.
DB_PATH=data/liga-futbol.sqlite
BACKUP_DIR=backups

# Preparado para piloto en Supabase/Postgres.
# La app sigue usando SQLite hasta activar el adaptador Postgres.
DATABASE_PROVIDER=sqlite
# DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# En produccion define el dominio publico, por ejemplo:
# CORS_ORIGIN=https://ligatinguindin.com
# Para pruebas en telefono, agrega la IP LAN concreta de tu Mac:
# CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://192.168.1.10:5173
CORS_ORIGIN=

# Frontend. En desarrollo puede quedar vacio.
# En produccion puede ser /api si web y API viven en el mismo dominio.
VITE_API_BASE_URL=
