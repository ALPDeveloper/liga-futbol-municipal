{
  "name": "liga-municipal-futbol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <22.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "dev:api": "node server/index.js",
    "dev:api:lan": "API_HOST=0.0.0.0 node server/index.js",
    "dev:api:postgres": "DATABASE_PROVIDER=postgres node server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "dev:web:lan": "vite --host 0.0.0.0",
    "build": "vite build",
    "start:api": "NODE_ENV=production node server/index.js",
    "start:api:postgres": "NODE_ENV=production DATABASE_PROVIDER=postgres node server/index.js",
    "start": "npm run build && NODE_ENV=production SERVE_STATIC=true node server/index.js",
    "check:deployment": "npm run build && npm run check:production-config",
    "backup:db": "node scripts/backup-database.js",
    "backup:db:cron": "BACKUP_STORAGE_BUCKET=ligatec-backups BACKUP_TIMEOUT_MS=600000 node scripts/backup-database.js",
    "verify:backup": "node scripts/verify-backup-restore.js",
    "restore:local-sqlite": "DATABASE_PROVIDER=sqlite DB_PATH=data/ligatec-local-test.sqlite SEED_DEMO_DATA=false SEED_DEMO_USERS=true node scripts/restore-local-sqlite.js",
    "test:local-affiliations": "node scripts/local-affiliation-api-test.js",
    "pilot:exports": "npm run export:store && npm run export:supabase-sql",
    "export:store": "node scripts/export-store-json.js",
    "export:supabase-sql": "node scripts/export-supabase-sql.js",
    "setup:postgres-schema": "node scripts/apply-postgres-schema.js",
    "setup:storage": "node scripts/setup-supabase-storage.js",
    "setup:backup-storage": "node scripts/setup-supabase-backups.js",
    "prepare:production-users": "node scripts/prepare-production-users.js",
    "check:postgres": "node scripts/check-postgres.js",
    "check:production-config": "NODE_ENV=production node scripts/check-production-config.js",
    "check:capture": "node scripts/check-capture-readiness.js",
    "import:postgres": "node scripts/import-postgres-store.js",
    "preview": "vite preview --host 127.0.0.1",
    "preview:lan": "vite preview --host 0.0.0.0",
    "test": "node scripts/domain-smoke-test.js && node scripts/referee-workflow-smoke-test.js && node scripts/live-clock-smoke-test.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  }
}
